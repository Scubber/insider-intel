# Paths (JSONL MVP storage; swap for Postgres later via DATABASE_URL)
RAW_ARTICLES_PATH=data/raw/articles.jsonl
PROCESSED_ARTICLES_PATH=data/processed/articles.jsonl

# Search / reader API
SEARCH_HOST=127.0.0.1
SEARCH_PORT=8000

# Browser origins allowed to call the API (comma-separated).
# Local static UI defaults; add your Cloudflare Pages origin when hosting.
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:3000,http://localhost:3000,null

# Drop weak articles on process; UI stream uses the same default (0.15)
PROCESS_MIN_SCORE=0.15

# --- Postgres sidecar (docker compose) --------------------------------------
# Data plane is undecided; Postgres is the compose default so it can be swapped
# later. Only shared/settings.py reads DATABASE_URL — keep it that way.
# Safe local-only defaults; compose falls back to these same values when unset.
# POSTGRES_USER=insider
# POSTGRES_PASSWORD=insider
# POSTGRES_DB=insider_intel
# POSTGRES_PORT=5432
# UI_PORT=5500
# In-container URL (host `db` is the compose service). From the WSL host use
# localhost:${POSTGRES_PORT} instead. docker-compose.yml already injects this;
# uncomment only to override.
# DATABASE_URL=postgresql://insider:insider@db:5432/insider_intel


# CourtListener RECAP (optional token from Free Law Project; anonymous works with limits)
# COURTLISTENER_API_TOKEN=
# Override defaults with comma-separated queries, e.g. employment / overemployment-adjacent:
# COURTLISTENER_QUERIES="insider trading",moonlighting employee,"concurrent employment","conflict of interest" employee
# COURTLISTENER_PAGE_SIZE=20
# COURTLISTENER_MAX_PAGES=1
# Search types to pull: dockets,opinions or "all" (default dockets = RECAP only)
# COURTLISTENER_TYPES=dockets
# Opinion-specific queries (empty = COURTLISTENER_QUERIES / built-in defaults)
# COURTLISTENER_OPINION_QUERIES=
# Fetch full opinion bodies for ITM scoring (1 extra GET per new opinion; token recommended)
# COURTLISTENER_FETCH_OPINION_TEXT=true
# COURTLISTENER_OPINION_TEXT_MAX_CHARS=20000
# Incremental re-runs: filed_after watermark overlap window, in days
# COURTLISTENER_LOOKBACK_DAYS=3

# IndiaCourts — Indian High Court judgments (CC BY 4.0 eCourts open dataset).
# $0 lane: parquet metadata + per-PDF fetch from the AWS Open Data bucket,
# local text extraction + insider-lexicon scan; only matches enter the corpus.
# Heavy work belongs on the Spark tenant — leave disabled elsewhere.
# INDIACOURTS_ENABLED=false
# INDIACOURTS_COURTS=            # restrict scope (court path codes); empty = all 25
# INDIACOURTS_HISTORY_FLOOR=2000-01-01
# INDIACOURTS_MAX_PDFS_PER_RUN=200
# INDIACOURTS_HISTORY_MAX_PDFS_PER_RUN=300
# INDIACOURTS_EXTRACT_MAX_PER_RUN=50
# INDIACOURTS_OCR_COMMAND=       # e.g. an olmOCR wrapper: '<cmd> <pdf>' -> text on stdout

# Google Alerts (or similar) RSS URLs — primary free discovery for HR/legal/business risk.
# Create alerts for: overemployment, moonlighting employee, "concurrent employment", etc.
# Then paste the RSS URLs here (comma-separated). See docs/sourcing.md.
# WEB_KEYWORD_FEED_URLS=https://www.google.com/alerts/feeds/...

# Reddit ingest — public JSON gets 429'd from cloud IPs; create a free
# "script" app at reddit.com/prefs/apps and set both for OAuth app auth.
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=

# DataTheftNews — no public RSS; pulls published posts via their public Supabase API.
# Anon key is discovered from the SPA when unset (same key their frontend ships).
# DATATHEFTNEWS_SUPABASE_URL=https://efjoefkaplfsgqwrbseg.supabase.co
# DATATHEFTNEWS_ANON_KEY=
# DATATHEFTNEWS_LIMIT=200

# One-way corporate export API (GET /export/articles). Never put corp Graph/SIEM
# credentials here — corporate tools pull OUT with this bearer token.
# EXPORT_API_TOKEN=replace-with-long-random-secret

# Write/ops auth: when set, /reload, subscription writes, and the ingest_url
# endpoints require this bearer. Unset = open (local dev). Prod sets it via
# Secret Manager on both the API service and the corpus-refresh job.
# ADMIN_API_TOKEN=replace-with-long-random-secret

# POST /extract/ttps assembles STORED forensics in code — no LLM runs at read
# time. The sliding-window caps only bound request abuse (<=0 disables).
# Defaults from shared/settings.py:
# EXTRACT_RATE_PER_IP_HOUR=30
# EXTRACT_RATE_GLOBAL_DAY=2000

# Enrichment LLM keys (ingest-time only — the API service never holds these).
# The summarizer/discoverer chains are configured per deployment; see
# .env.spark.example for the full production (sparky) enrichment knobs:
# SUMMARIZER_LLM_PROVIDER / SUMMARIZER_MODEL / SUMMARIZER_MAX_ARTICLES_PER_RUN /
# SUMMARIZER_BACKFILL_RESERVE / SUMMARIZER_REENRICH_MISSED_LIMIT /
# OPENAI_COMPAT_* (incl. OPENAI_COMPAT_GUIDED_JSON) / DOCKET_FOLLOW_MAX_PER_RUN /
# DOCKET_FOLLOW_REPOLL_DAYS / LLM_CUSTOM_PROVIDERS.
# ANTHROPIC_API_KEY=
# XAI_API_KEY=
# XAI_MODEL=grok-4
# OPENAI_API_KEY=          # real OpenAI (retargets the openai provider from Ollama)
# GEMINI_API_KEY=          # Google AI Studio key (OpenAI-compatible endpoint)
# GEMINI_MODEL=gemini-2.5-flash

# Social — parked since 2026-08-16 (SOCIAL_INGEST_ENABLED defaults false;
# cloud IPs get 429'd without OAuth — see the Reddit OAuth block above).
# Sources come from the subscription store; REDDIT_SUBREDDITS is only a
# fallback when no subscriptions exist.
# SOCIAL_INGEST_ENABLED=false
# REDDIT_SUBREDDITS=overemployed,jobsearchhacks
# REDDIT_LIMIT=50
# REDDIT_USER_AGENT=insider-intel/0.1 (insider-threat research aggregator)
# REDDIT_DELAY_SECONDS=2.0

# Social — X / Twitter API v2 (paid bearer token; unset = X lane skipped).
# X_BEARER_TOKEN=
# X_HANDLES=
# X_MAX_RESULTS=25

# Social subscriptions store (single-tenant watchlist)
# SOCIAL_SUBSCRIPTIONS_PATH=data/config/social_subscriptions.json

# Use-case / insider-type classifier. Heuristics always run; set a provider to
# refine low-confidence social posts with an LLM.
#   anthropic -> claude-haiku-4-5 (cheap/fast; needs ANTHROPIC_API_KEY)
#   openai    -> any OpenAI-compatible endpoint (default: local Ollama;
#                with OPENAI_API_KEY set it targets real OpenAI / gpt-4o-mini)
#   gemini    -> Google Gemini via GEMINI_API_KEY (default gemini-2.5-flash)
# CLASSIFIER_LLM_PROVIDER=none
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5
# OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_MODEL=llama3.1:8b
# HTTP timeout for openai-compat chat calls (summarizer/discoverer/synthesizer
# chains). Raise on a self-hosted box where a 12k-token enrichment can outlast
# the 90s default and needlessly fall through to a funded fallback.
# OPENAI_COMPAT_TIMEOUT_SECONDS=90
# CLASSIFY_LLM_CHANNELS=social
