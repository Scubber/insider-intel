# Spark tenant config — copy to .env.spark (gitignored) and fill in.
# Used by docker-compose.spark.yml (the refresh job) and scripts/spark_refresh.sh.
# Placeholders only in this example: never commit real keys, hostnames, or
# tailnet names (repo is public; detect-secrets guards commits).

# --- LLM chain: local vLLM only by default ------------------------------------
# The named custom provider avoids the bare-OPENAI_API_KEY retargeting landmine
# entirely (see docs/dgx-spark.md gotchas). base_url is the docker-network
# address of vLLM on the shared `sparky` network; model must match the id vLLM
# serves (check GET /v1/models).
LLM_CUSTOM_PROVIDERS={"sparky":{"base_url":"http://vllm:8000/v1","model":"nvidia/Qwen3.6-35B-A3B-NVFP4","api_key_env":"SPARKY_API_KEY"}}
SPARKY_API_KEY=REPLACE_WITH_VLLM_API_KEY
# sparky ONLY by default: every local failure then costs a slot (re-swept free
# next cycle), never money. Appending a funded fallback (e.g. `sparky,anthropic`
# + ANTHROPIC_API_KEY) is a deliberate opt-in — with the caps below raised, one
# slow/dead vLLM turns the whole raised budget into paid API calls. That is
# exactly the 2026-08-16 incident (see docs/dgx-spark.md §4).
SUMMARIZER_LLM_PROVIDER=sparky
# The client is a NON-STREAMING POST, so this is an end-to-end generation
# deadline, not an idle timeout: enrichment may generate up to 12k tokens
# (ENRICH_MAX_TOKENS), so budget max_tokens ÷ your measured decode tok/s, plus
# headroom. Example: 12,000 ÷ 15 tok/s ≈ 800s → 900. A too-small value silently
# partitions work: the local box finishes only thin cases and every rich case
# times out (then bills, if a funded fallback is chained).
OPENAI_COMPAT_TIMEOUT_SECONDS=900
# Prod-parity trickle caps. Raise only after proving sustained cycle time:
# each enriched article costs minutes of serial decode, and a cycle must fit
# the 6h cadence (the wrapper skips overlapping runs). If you lower
# SUMMARIZER_MAX_ARTICLES_PER_RUN, lower SUMMARIZER_BACKFILL_RESERVE with it —
# reserve is clamped to the cap, and reserve == cap leaves ZERO budget for
# newly ingested articles (silently: no error, new cases just stay un-enriched).
SUMMARIZER_MAX_ARTICLES_PER_RUN=25
SUMMARIZER_BACKFILL_RESERVE=15
DISCOVERER_MAX_ARTICLES_PER_RUN=3

# --- Source credentials (same values as the Cloud Run job's secrets) ----------
COURTLISTENER_API_TOKEN=REPLACE_ME
# REDDIT_CLIENT_ID / REDDIT_CLIENT_SECRET / X_BEARER_TOKEN / FEEDLY_* etc. as
# needed — see .env.example for the full catalog.

# --- Corpus sync (consumed by scripts/spark_refresh.sh, not the container) ----
# Private bucket the Cloud Run service mounts; the service-account key should
# grant access to this bucket only.
# SAFE DEFAULT: the spark-staging/ prefix. Nothing on the website reads it, so
# an unproven cycle can't touch production. Pointing this at the bucket ROOT is
# a cutover step (docs/dgx-spark.md §4) taken only after a proven staging cycle
# AND after pausing the Cloud Scheduler job — never a fill-in-the-blank.
SPARK_CORPUS_BUCKET=gs://REPLACE_WITH_BUCKET/spark-staging
GOOGLE_APPLICATION_CREDENTIALS=/home/REPLACE_ME/.config/insider-intel-spark-sa.json
# Cloud Run API to poke after a successful push (ADMIN_API_TOKEN bearer).
# EMPTY by default = reload skipped. Set it only at cutover, when the bucket
# above is the prod root — a staging push has nothing the API could reload,
# and /reload is the API's OOM-fatal index swap.
SPARK_RELOAD_URL=
ADMIN_API_TOKEN=REPLACE_WITH_ADMIN_TOKEN
